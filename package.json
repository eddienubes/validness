{
  "name": "validness",
  "version": "2.1.0",
  "description": "Your favourite library for validating incoming data in express.js",
  "keywords": [
    "DTO",
    "body",
    "class-transformer",
    "class-validator",
    "correct",
    "data",
    "dto",
    "express",
    "form",
    "formidable",
    "free",
    "github",
    "incoming data",
    "multer",
    "multipart/form-data",
    "nestjs",
    "next",
    "node",
    "nodejs",
    "opensource",
    "proper",
    "query",
    "quora",
    "source",
    "star",
    "transformer",
    "tweet",
    "valid",
    "validation",
    "validator",
    "validness"
  ],
  "homepage": "https://github.com/eddienubes/validness#readme",
  "bugs": {
    "url": "https://github.com/eddienubes/validness/issues"
  },
  "license": "MIT",
  "author": "Eddie Nubes <cool.gegeg@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddienubes/validness.git"
  },
  "files": [
    "build/**/*"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "check:package": "publint --pack pnpm && d=$(mktemp -d) && pnpm pack --pack-destination \"$d\" > /dev/null && attw \"$d\"/*.tgz --profile esm-only; rc=$?; rm -rf \"$d\"; exit $rc",
    "lint:fix": "oxlint --type-aware --fix",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "http-status-codes": "^2.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/formidable": "^3.5.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "coverage-badges-cli": "^2.2.0",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "multer": "^2.4.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "sagetest": "^0.1.27",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@types/formidable": "^3.0.0",
    "@types/multer": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "express": "^5.0.0",
    "formidable": "^3.0.0",
    "multer": "^2.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "multer": {
      "optional": true
    },
    "formidable": {
      "optional": true
    },
    "@types/multer": {
      "optional": true
    },
    "@types/formidable": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.12",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
